generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RepaymentType {
  EQUAL_INSTALLMENT
  EQUAL_PRINCIPAL
}

enum SchoolType {
  PUBLIC
  PRIVATE
}

enum UnivType {
  NATIONAL
  PRIVATE_HUMANITIES
  PRIVATE_SCIENCE
}

model Simulation {
  id                          Int            @id @default(autoincrement())
  name                        String         @default("未保存のシミュレーション")
  loanAmount                  Float
  termYears                   Int
  repaymentType               RepaymentType  @default(EQUAL_INSTALLMENT)
  useFiveYearRule             Boolean        @default(false)
  use125PercentRule           Boolean        @default(false)
  totalPayment                Float          @default(0)
  bonusRepaymentPerOccurrence Float          @default(0)
  mortgageDeductionRate       Float          @default(0)
  mortgageDeductionYears      Int            @default(0)
  mortgageDeductionMaxPerPerson Float        @default(0)
  mortgageDeductionClaimants    Int          @default(1)
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  ratePeriods RatePeriod[]
  household   Household?
}

model RatePeriod {
  id           Int        @id @default(autoincrement())
  simulationId Int
  startYear    Int
  endYear      Int
  annualRate   Float

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
}

model Household {
  id                      Int     @id @default(autoincrement())
  simulationId            Int     @unique
  husbandAnnualIncome     Float   @default(0)
  wifeAnnualIncome        Float   @default(0)
  husbandRaiseRate        Float   @default(2)
  wifeRaiseRate           Float   @default(2)
  monthlyLivingCost       Float   @default(20)
  husbandAge              Int     @default(30)
  wifeAge                 Int     @default(30)
  husbandRetirementAge    Int     @default(65)
  wifeRetirementAge       Int     @default(65)
  husbandCashAssets           Float   @default(0)
  husbandInvestmentAssets     Float   @default(0)
  wifeCashAssets              Float   @default(0)
  wifeInvestmentAssets        Float   @default(0)
  monthlyInvestment           Float   @default(0)
  averageYield                Float   @default(3)
  husbandSummerBonusMonths    Float   @default(0)
  husbandWinterBonusMonths    Float   @default(0)
  wifeSummerBonusMonths       Float   @default(0)
  wifeWinterBonusMonths       Float   @default(0)

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  children   Child[]
  lifeEvents LifeEvent[]
}

model Child {
  id                        Int        @id @default(autoincrement())
  householdId               Int
  name                      String
  birthYear                 Int
  birthMonth                Int        @default(4)
  nursing                   SchoolType @default(PUBLIC)
  elementary                SchoolType @default(PUBLIC)
  middle                    SchoolType @default(PUBLIC)
  high                      SchoolType @default(PUBLIC)
  university                UnivType   @default(NATIONAL)
  husbandParentalLeaveMonths Int       @default(0)
  wifeParentalLeaveMonths   Int        @default(12)
  extraMonthlyLivingCost    Float      @default(2)
  monthlyExtracurricular    Float      @default(0)
  customNursingCost         Float      @default(19)
  customElementaryCost      Float      @default(5)
  customMiddleCost          Float      @default(49)
  customHighCost            Float      @default(51)
  customUniversityCost      Float      @default(82)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model LifeEvent {
  id          Int       @id @default(autoincrement())
  householdId Int
  eventName   String
  year        Int
  amount      Float

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}
